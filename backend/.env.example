# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Application Settings
PROJECT_NAME="Lexguard Legal Research & Verification System"
API_V1_STR="/api/v1"

# Security & Secrets
SECRET_KEY=change-this-to-a-super-secret-random-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie & CSRF Settings
COOKIE_NAME=lexguard_access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
CSRF_SECRET=change-this-to-a-csrf-secret-key

# Database Connection
# SQLite default for zero-setup local dev/demo:
DATABASE_URL=sqlite:///./lexguard.db
# PostgreSQL with pgvector for production/Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexguard

# Storage Settings
STORAGE_DIR=./storage/cases

# Hugging Face Open-Source Model Stack
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LEGAL_NER_MODEL_NAME=law-ai/InLegalBERT
LOCAL_LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
USE_LOCAL_LLM=True
HF_TOKEN=
DEVICE=cpu
QUANTIZATION_BITS=4

# Anthropic Claude Fallback (Optional)
ANTHROPIC_API_KEY=
USE_MOCK_LLM=False

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
