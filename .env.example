# ==============================================================================
# Lexguard - Root Environment Template
# Copy this file to .env and configure the variables accordingly.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Lexguard Legal Research & Cryptographic Verification System"
API_V1_STR="/api/v1"

# Cryptography & Session Tokens
SECRET_KEY=change-this-to-a-super-secret-random-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie & CSRF Security
COOKIE_NAME=lexguard_access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
CSRF_SECRET=change-this-to-a-csrf-secret-key

# Database Connection
DATABASE_URL=sqlite:///./lexguard.db

# Physical Storage Directory
STORAGE_DIR=./storage/cases

# Open-Source Hugging Face ML Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LEGAL_NER_MODEL_NAME=law-ai/InLegalBERT
LOCAL_LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
USE_LOCAL_LLM=True
HF_TOKEN=
DEVICE=cpu
QUANTIZATION_BITS=4

# Optional Anthropic Claude API Fallback
ANTHROPIC_API_KEY=
USE_MOCK_LLM=False

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
